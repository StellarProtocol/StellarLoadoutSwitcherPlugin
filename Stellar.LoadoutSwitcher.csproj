<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.LoadoutSwitcher</RootNamespace>
    <AssemblyName>Stellar.LoadoutSwitcher</AssemblyName>
    <Version>2.4.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- DS binding: consumes IDeepSlumber.ApplySetupAsync + DeepSlumberSetup incl. the tree
         (DeepSlumberAreaBinding.NormalNodes, framework 2.5.0). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.5.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>
  <!-- The unit-test project is a sibling folder under this repo root; keep its sources out of the
       plugin's default `**/*.cs` glob (else its xUnit test files + generated obj land in the plugin). -->
  <ItemGroup>
    <Compile Remove="Stellar.LoadoutSwitcher.Tests/**/*.cs" />
    <EmbeddedResource Remove="Stellar.LoadoutSwitcher.Tests/**/*" />
    <None Remove="Stellar.LoadoutSwitcher.Tests/**/*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.LoadoutSwitcher.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.LoadoutSwitcher.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.LoadoutSwitcher.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.LoadoutSwitcher.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.LoadoutSwitcher.Lang.fil.json" />
    <EmbeddedResource Include="Resources/loadoutswitcher-icon.png" LogicalName="Stellar.LoadoutSwitcher.loadoutswitcher-icon.png" />
  </ItemGroup>
</Project>
