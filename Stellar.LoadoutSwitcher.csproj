<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.LoadoutSwitcher</RootNamespace>
    <AssemblyName>Stellar.LoadoutSwitcher</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Requires the framework release that adds ILoadout + INotifications (>= 1.2.0). -->
    <PackageReference Include="Stellar.Abstractions" Version="1.2.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.2.0" />
  </ItemGroup>
</Project>
